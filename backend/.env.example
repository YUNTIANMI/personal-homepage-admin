# =============================================================================
# 环境变量模板
# 复制为 .env 或 .env.local 后填写（二者均被 gitignore，禁止入库）
#   本地运行应用：这些变量会被 application-dev.yml 读取
#   docker compose：这些变量会被 docker-compose.yml 读取
# =============================================================================

# ---------- 数据库 ----------
DB_HOST=localhost
# 端口说明：
#   - 本机安装版 MySQL（E:\MySQL Server 8.4）实际监听 3308
#   - docker-compose 里的 MySQL 映射到宿主机 3307
#   - 请按你实际使用的实例填写；默认 3306 仅供「标准 3306 端口」的机器
DB_PORT=3308
DB_NAME=luoji_blog
DB_USER=luoji
DB_PASSWORD=          # 必填

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=       # 本地留空

# ---------- 应用 ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---------- docker-compose 专用（MySQL 容器内初始化用） ----------
# 注意：docker-compose 的 MySQL 映射到宿主机 3307，应用需把 DB_PORT 改为 3307
MYSQL_ROOT_PASSWORD=root123456
